{
  "name": "@azohra/meteo",
  "version": "0.6.1",
  "description": "Azohra Meteo: open tooling for wind-sport weather. First capability — station: heterogeneous weather-station feeds behind one wire contract, vendor adapters, a mountable feed handler, and native rendering as React components or framework-free custom elements.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/meteo.git"
  },
  "homepage": "https://meteo.azohra.com",
  "keywords": [
    "weather",
    "meteo",
    "weather-station",
    "wind",
    "anemometer",
    "react",
    "web-components",
    "custom-elements",
    "paragliding",
    "windnerd",
    "tempest",
    "campbell-scientific",
    "live-wind"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "sideEffects": [
    "*.css",
    "dist/station/elements/register.js"
  ],
  "files": [
    "dist",
    "station/styles.css",
    "station/README.md",
    "docs",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./station": "./dist/station/index.js",
    "./station/client": "./dist/station/client/index.js",
    "./station/server": "./dist/station/server/index.js",
    "./station/react": "./dist/station/react/index.js",
    "./station/elements": "./dist/station/elements/index.js",
    "./station/elements/register": "./dist/station/elements/register.js",
    "./station/styles.css": "./station/styles.css"
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas": "node scripts/emit-schemas.mjs",
    "readme:assets": "node scripts/generate-readme-assets.mjs"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^18.19.130",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "packageManager": "pnpm@10.12.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
